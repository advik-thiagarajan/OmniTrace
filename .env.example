# ============================================================
# OmniTrace Configuration Environment Variables
# ============================================================

# Application Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# Neo4j Graph Database Configuration
# Default connection string, set NEO4J_ENABLED=true if connecting to a live instance
NEO4J_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=omnitrace_password
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_POOL_SIZE=50

# Ollama Local AI Configuration
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=60

# Real-Time WebSocket & File Watcher Settings
WS_HEARTBEAT_INTERVAL=15
WATCHDOG_DEBOUNCE_MS=500
MAX_BLAST_RADIUS_DEPTH=4

# Logging
LOG_LEVEL=INFO
